{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimgewebe.local/schemas/audiozentrale-workspace-state.v1.schema.json",
  "title": "Audiozentrale Workspace State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "product_model_sha256",
    "workspace_id",
    "active_setup_id",
    "setups",
    "takes",
    "ui_state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "audiozentrale_workspace_state"
    },
    "product_model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "workspace_id": {
      "$ref": "#/$defs/id"
    },
    "active_setup_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "setups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setup"
      }
    },
    "takes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/take"
      }
    },
    "ui_state": {
      "$ref": "#/$defs/ui_state"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signal_type": {
      "enum": [
        "audio-mono",
        "audio-stereo",
        "midi"
      ]
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "configured",
        "physical-open",
        "executable"
      ],
      "properties": {
        "observed": {
          "$ref": "#/$defs/truth_observed"
        },
        "configured": {
          "$ref": "#/$defs/truth_configured"
        },
        "physical-open": {
          "$ref": "#/$defs/truth_physical_open"
        },
        "executable": {
          "$ref": "#/$defs/truth_executable"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "label",
        "signal_type"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/id"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "signal_type": {
          "$ref": "#/$defs/signal_type"
        }
      }
    },
    "module_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "bypassed",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "module_id": {
          "$ref": "#/$defs/id"
        },
        "bypassed": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "minimum",
        "maximum",
        "value",
        "modulatable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "value": {
          "type": "number"
        },
        "modulatable": {
          "type": "boolean"
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source",
        "target",
        "modules",
        "macros"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "target": {
          "$ref": "#/$defs/endpoint"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module_instance"
          }
        },
        "macros": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macro"
          }
        }
      }
    },
    "modulation_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/id"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modulation_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lane_id",
        "module_instance_id",
        "parameter_id",
        "macro_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "module-parameter",
            "lane-macro"
          ]
        },
        "lane_id": {
          "$ref": "#/$defs/id"
        },
        "module_instance_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "parameter_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "macro_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      }
    },
    "modulation_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "depth",
        "smoothing_ms",
        "enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/modulation_source"
        },
        "target": {
          "$ref": "#/$defs/modulation_target"
        },
        "depth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "smoothing_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "parameter_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "module_instance_id",
        "parameter_id",
        "value"
      ],
      "properties": {
        "lane_id": {
          "$ref": "#/$defs/id"
        },
        "module_instance_id": {
          "$ref": "#/$defs/id"
        },
        "parameter_id": {
          "$ref": "#/$defs/id"
        },
        "value": {}
      }
    },
    "macro_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "macro_id",
        "value"
      ],
      "properties": {
        "lane_id": {
          "$ref": "#/$defs/id"
        },
        "macro_id": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parameter_overrides",
        "macro_overrides"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parameter_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_override"
          }
        },
        "macro_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macro_override"
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "template_ref",
        "profile_refs",
        "truth",
        "lanes",
        "modulation_links",
        "scenes",
        "active_scene_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "draft",
            "template"
          ]
        },
        "template_ref": {
          "$ref": "#/$defs/id"
        },
        "profile_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "truth": {
          "$ref": "#/$defs/truth"
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lane"
          }
        },
        "modulation_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modulation_link"
          },
          "maxItems": 64
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          }
        },
        "active_scene_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "source_ref"
      ],
      "properties": {
        "lane_id": {
          "$ref": "#/$defs/id"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rate_hz",
        "channels",
        "sample_format"
      ],
      "properties": {
        "rate_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 384000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "sample_format": {
          "enum": [
            "s24le",
            "s32le",
            "f32le"
          ]
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "target_ref",
        "evidence_refs"
      ],
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "software",
            "mixed",
            "none",
            "unknown"
          ]
        },
        "target_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "take": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "immutable",
        "setup_id",
        "scene_id",
        "source_binding",
        "format",
        "monitoring",
        "started_at",
        "ended_at",
        "file_status",
        "artifact_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "immutable": {
          "const": true
        },
        "setup_id": {
          "$ref": "#/$defs/id"
        },
        "scene_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "source_binding": {
          "$ref": "#/$defs/source_binding"
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "monitoring": {
          "$ref": "#/$defs/monitoring"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "file_status": {
          "enum": [
            "recording",
            "finalized",
            "recoverable",
            "failed"
          ]
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ui_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "depth",
        "focus_id"
      ],
      "properties": {
        "place": {
          "enum": [
            "now",
            "setups",
            "library",
            "system"
          ]
        },
        "depth": {
          "enum": [
            "compact",
            "expanded",
            "focus"
          ]
        },
        "focus_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "truth_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "observed",
            "absent",
            "unknown",
            "unavailable"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "truth_configured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "configured",
            "not-configured",
            "unavailable"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "truth_physical_open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "confirmed",
            "open",
            "not-required",
            "unavailable"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "truth_executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "executable",
            "blocked",
            "planned",
            "unavailable"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
