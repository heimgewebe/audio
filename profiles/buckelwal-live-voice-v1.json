  "input": {
    "device": "roland-fp-30x",
    "transport": "alsa-sequencer-via-aseqdump",
    "note_range": [
      21,
      108
    ],
    "sustain_controller": 64,
    "optional_controllers": {
      "1": "bounded-natural-flutter",
      "11": "expression",
      "67": "distance-and-depth"
    },
    "panic_controllers": {
      "120": "immediate-all-sound-off",
      "123": "all-notes-off-with-natural-release"
    }
  },
  "audio": {
    "sample_rate_hz": 48000,
    "channels": 2,
    "format": "f32",
    "block_frames": 128,
    "default_master_gain": 0.16,
    "maximum_master_gain": 0.25,
    "default_sink_policy": "current-pipewire-default-unless-explicit-target",
    "reference_sink": "motu-m2",
    "pcm_transport": {
      "maximum_supported_page_size_bytes": 4096,
      "capacity_formula": "next-power-of-two-pages-covering-one-block",
      "observed_pipe_bytes_at_default_block": 4096,
      "observed_buffered_frames_at_default_block": 512,
      "realtime_pacing": true,
      "catch_up_bursts": false,
      "blocking_write": false,
      "stall_timeout_seconds": 2.0
    }
  },
  "runtime": {
    "manager": "transient-systemd-user-service",
    "unit": "audio-buckelwal-live-voice-v1.service",
    "readiness": {
      "systemd_service_type": "notify",
      "minimum_initialization_seconds": 0.1,
      "requires": [
        "midi-process-alive",
        "pipewire-process-alive",
        "bounded-pcm-consumption",
        "selected-voice-backend-loaded"
      ]
    },
    "mode_switch_preserves": [
      "midi-port",
      "pipewire-target",
      "master-gain",
      "latency-frames",
      "runtime-limit"
    ],
    "maximum_runtime_seconds": 21600,
    "memory_max_bytes": 268435456,
    "cpu_quota_percent": 80,
    "tasks_max": 32,
    "journal_rate_limit": {
      "interval_seconds": 30,
      "burst": 100
    },
    "event_logging": false,
    "standalone_sfizz_jack": false,
    "midi_queue": {
      "maximum_pending_events": 256,
      "maximum_events_per_audio_block": 64,
      "overflow_behavior": "bounded-reader-backpressure-preserves-event-order"
    }
  },
  "truth_boundary": {
    "current_backend": "source-derived-bandlimited-wavetable-morph",
    "biological_voice_model_claim": false,
    "realism_claim": "source-derived-periodic-timbre-resynthesis-not-biological-model-and-not-recorded-phrase-playback",
    "keyboard_contract": "all-88-keys-are-standard-chromatic-notes-with-no-presets-zones-or-control-keys",
    "preserved_alternative_backends": [
      "source-derived-organic-resynthesis",
      "licensed-humpback-sample-bank",
      "deterministic-synthetic-ufo-mode"
    ],
    "stable_contract": "roland-gesture-semantics"
  }
}
