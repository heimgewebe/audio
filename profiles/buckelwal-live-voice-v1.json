{
  "schema_version": 2,
  "kind": "buckelwal_live_voice_profile",
  "name": "Buckelwal Live Voice",
  "voice_model": "monophonic-last-note-priority",
  "default_voice_mode": "realistic",
  "voice_modes": {
    "realistic": {
      "backend": "licensed-humpback-sample-bank",
      "source_catalog": "assets/whale-sources/SOURCES.json",
      "manifest": "assets/whale-sources/processed/manifest.json",
      "source_count": 8,
      "clip_count": 19,
      "keyboard_slot_count": 27,
      "note_range": [
        21,
        108
      ],
      "maximum_total_pitch_shift_semitones": 4,
      "pitch_bend_included_in_limit": true,
      "hold": "looped-original-phrase-with-equal-power-crossfade",
      "legato": "multilayer-90-millisecond-equal-power-crossfade",
      "detached_retrigger": "restart-selected-original-phrase-with-phrase-local-hold-time",
      "register_selection": "nearest-root-first-category-tiebreak",
      "nominal_register_preferences": {
        "21-48": "low-preference-moo-groan-and-body-sounds",
        "49-84": "song-preference",
        "85-108": "high-preference-wheeze-breath-and-high-calls"
      },
      "cross_boundary_assignments": {
        "42": "song",
        "46": "song",
        "84": "high",
        "86": "song",
        "90": "song"
      },
      "maximum_fading_layers": 3,
      "retarget_overflow_policy": "coalesce-to-latest-target-until-fade-slot-is-free",
      "modulation_included_in_pitch_limit": true
    },
    "ufo": {
      "backend": "deterministic-synthetic-scaffold",
      "status": "preserved-experimental-mode-not-realism-reference",
      "mapping": "continuous-34-to-1850-hz-synthetic-space",
      "legato": "continuous-pitch-register-and-formant-glide",
      "detached_retrigger": "freeze-old-envelope-six-millisecond-fade-out-then-new-attack"
    }
  },
  "input": {
    "device": "roland-fp-30x",
    "transport": "alsa-sequencer-via-aseqdump",
    "note_range": [
      21,
      108
    ],
    "sustain_controller": 64,
    "optional_controllers": {
      "1": "bounded-natural-flutter",
      "11": "expression",
      "67": "distance-and-depth"
    },
    "panic_controllers": {
      "120": "immediate-all-sound-off",
      "123": "all-notes-off-with-natural-release"
    }
  },
  "audio": {
    "sample_rate_hz": 48000,
    "channels": 2,
    "format": "f32",
    "block_frames": 128,
    "default_master_gain": 0.16,
    "maximum_master_gain": 0.25,
    "default_sink_policy": "current-pipewire-default-unless-explicit-target",
    "reference_sink": "motu-m2",
    "pcm_transport": {
      "maximum_supported_page_size_bytes": 4096,
      "capacity_formula": "next-power-of-two-pages-covering-one-block",
      "observed_pipe_bytes_at_default_block": 4096,
      "observed_buffered_frames_at_default_block": 512,
      "realtime_pacing": true,
      "catch_up_bursts": false,
      "blocking_write": false,
      "stall_timeout_seconds": 2.0
    }
  },
  "runtime": {
    "manager": "transient-systemd-user-service",
    "unit": "audio-buckelwal-live-voice-v1.service",
    "readiness": {
      "systemd_service_type": "notify",
      "minimum_initialization_seconds": 0.1,
      "requires": [
        "midi-process-alive",
        "pipewire-process-alive",
        "bounded-pcm-consumption",
        "selected-voice-backend-loaded"
      ]
    },
    "mode_switch_preserves": [
      "midi-port",
      "pipewire-target",
      "master-gain",
      "latency-frames",
      "runtime-limit"
    ],
    "maximum_runtime_seconds": 21600,
    "memory_max_bytes": 268435456,
    "cpu_quota_percent": 80,
    "tasks_max": 32,
    "journal_rate_limit": {
      "interval_seconds": 30,
      "burst": 100
    },
    "event_logging": false,
    "standalone_sfizz_jack": false,
    "midi_queue": {
      "maximum_pending_events": 256,
      "maximum_events_per_audio_block": 64,
      "overflow_behavior": "bounded-reader-backpressure-preserves-event-order"
    }
  },
  "truth_boundary": {
    "current_backend": "licensed-humpback-sample-bank",
    "biological_voice_model_claim": false,
    "realism_claim": "real-recording-playback-with-bounded-resampling-not-biological-resynthesis",
    "preserved_alternative_backend": "deterministic-synthetic-ufo-mode",
    "stable_contract": "roland-gesture-semantics"
  }
}
