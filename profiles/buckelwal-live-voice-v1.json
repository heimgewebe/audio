        "crossfade_seconds": 0.14,
        "sequence": "gesture-seeded-eight-segment-pattern",
        "excitation": "source-signal-coupled-without-independent-noise"
      },
      "voice_model_manifest": "assets/whale-sources/voice-model/manifest.json",
