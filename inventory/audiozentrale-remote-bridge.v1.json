{
  "schema_version": 1,
  "kind": "audiozentrale_remote_bridge_contract",
  "id": "audiozentrale-remote-bridge-v1",
  "status": "runtime-evidence-gated",
  "schema_binding": {
    "path": "schemas/audiozentrale-remote-bridge.v1.schema.json",
    "sha256": "ffa8d998a11ce8452dfa6ac74a2692b332f674b2b764e7835c7811f9611417fd"
  },
  "bridge": {
    "listen_host": "127.0.0.1",
    "listen_port": 8766,
    "backend_host": "127.0.0.1",
    "backend_port": 8765,
    "methods": [
      "GET",
      "HEAD",
      "POST"
    ],
    "static_routes": [
      "/",
      "/index.html",
      "/app.js",
      "/whale-lesson.js",
      "/sw.js",
      "/styles.css",
      "/manifest.webmanifest",
      "/icon-180.png",
      "/icon-192.png",
      "/icon-512.png",
      "/whale-learning-reference.wav",
      "/whale-learning-morph.wav",
      "/whale-learning-envelope.wav",
      "/whale-learning-periodicity.wav",
      "/whale-learning-articulation.wav"
    ],
    "fixed_api_routes": [
      "/api/v1/health",
      "/api/v1/telemetry",
      "/api/v1/replay",
      "/api/v1/whale/lesson",
      "/api/v1/recordings"
    ],
    "snapshot_queries": [
      "",
      "refresh=1"
    ],
    "profile_plan_pattern": "/api/v1/profiles/{profile_id}/plan",
    "recording_audio_pattern": "/api/v1/recordings/{session_id}/audio",
    "request_header_forward": [
      "If-None-Match",
      "Range"
    ],
    "backend_headers_synthesized": [
      "Host",
      "Connection"
    ],
    "response_header_forward": [
      "Content-Type",
      "Cache-Control",
      "ETag",
      "Accept-Ranges",
      "Content-Range",
      "Content-Security-Policy",
      "Referrer-Policy",
      "X-Content-Type-Options",
      "X-Frame-Options",
      "Cross-Origin-Opener-Policy",
      "Cross-Origin-Resource-Policy",
      "Permissions-Policy"
    ],
    "bridge_response_header": {
      "name": "X-Audio-Remote-Bridge",
      "value": "read-only-v1"
    },
    "json_scrubbing": {
      "enabled": true,
      "policy": "recursive-key-name",
      "must_remove": [
        "action_token"
      ],
      "invalid_json": "fail-closed"
    },
    "effect_authority": true,
    "backend_remote_exposure": false,
    "effect_scope": [
      "whale:start",
      "whale:mode",
      "whale:stop",
      "recording:plan",
      "recording:start",
      "recording:stop",
      "recording:recover"
    ],
    "effect_exclusions": [
      "profiles",
      "routing",
      "devices",
      "system"
    ],
    "remote_action": {
      "session_route": "/bridge/v1/session",
      "action_route": "/bridge/v1/actions/whale",
      "tailnet_host": "heim-pc.tail6dbb90.ts.net:9443",
      "session_header": "X-Audio-Bridge-Session",
      "session_ttl_seconds": 900,
      "session_capacity": 8,
      "max_body_bytes": 512,
      "operations": [
        "start",
        "mode",
        "stop"
      ],
      "modes": [
        "morph",
        "organic",
        "realistic",
        "ufo"
      ],
      "tailscale_identity_required": true,
      "session_identity_bound": true,
      "backend_action_token_exposed": false,
      "action_response_marker": "whale-action-v1",
      "effects_header": "X-Audio-Remote-Effects",
      "effects_value": "whale-v1",
      "session_method": "POST",
      "recording_action_route": "/bridge/v1/actions/recording",
      "recording_max_body_bytes": 1024,
      "recording_operations": [
        "plan",
        "start",
        "stop",
        "recover"
      ],
      "recording_modes": [
        "voice",
        "piano-vocal"
      ],
      "recording_action_response_marker": "recording-action-v1",
      "recording_effects_value": "recording-v1"
    }
  },
  "tailscale_serve": {
    "tool": "tailscale serve",
    "https_port": 9443,
    "target": "http://127.0.0.1:8766",
    "tailnet_only": true,
    "public_exposure": false,
    "preserve_other_config": true,
    "forbidden_operations": [
      "funnel",
      "reset",
      "clear"
    ]
  },
  "runtime_acceptance": {
    "bridge_service_verified": false,
    "tailscale_serve_verified": false,
    "ipad_https_reachability_verified": false,
    "ipad_safari_verified": false,
    "pwa_installation_verified": false
  },
  "runtime_acceptance_state": {
    "path": "~/.local/state/audio-remote-bridge-v1/acceptance.json",
    "mode": "0600",
    "max_ttl_seconds": 604800,
    "fail_closed": true,
    "binds_bridge_sha256": true
  }
}
