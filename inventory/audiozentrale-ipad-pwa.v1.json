{
  "schema_version": 1,
  "kind": "audiozentrale_ipad_pwa_contract",
  "contract_id": "audiozentrale-ipad-pwa-v1",
  "status": "specified-not-physically-verified",
  "schema_binding": {
    "path": "schemas/audiozentrale-ipad-pwa.v1.schema.json",
    "sha256": "47b665722b36e4f316c65c74743970f5a8f24e7a63af649a92fa01976913aa23"
  },
  "surface": {
    "canonical_frontend": [
      "ui/index.html",
      "ui/app.js",
      "ui/styles.css"
    ],
    "added_assets": [
      "ui/manifest.webmanifest",
      "ui/sw.js",
      "ui/icon-180.png",
      "ui/icon-192.png",
      "ui/icon-512.png"
    ],
    "frontend_framework_dependencies": [],
    "second_application_created": false
  },
  "install_metadata": {
    "manifest_path": "ui/manifest.webmanifest",
    "manifest_route": "/manifest.webmanifest",
    "manifest_mime_type": "application/manifest+json",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "theme_color": "#0d1414",
    "background_color": "#0b1111",
    "viewport_fit": "cover",
    "apple_mobile_web_app_capable": true,
    "apple_mobile_web_app_status_bar_style": "black-translucent",
    "apple_touch_icon_route": "/icon-180.png",
    "icons": [
      {
        "path": "ui/icon-180.png",
        "route": "/icon-180.png",
        "pixel_size": 180,
        "mime_type": "image/png",
        "sha256": "3d525aeb31aa74fbab8898733478bd638a51ea37a400693ecef42c48c55ec50e"
      },
      {
        "path": "ui/icon-192.png",
        "route": "/icon-192.png",
        "pixel_size": 192,
        "mime_type": "image/png",
        "sha256": "2ccce338bba861eeb2efee1db074487dd9ebc25d3f2db1bf5d5a431c5b5dcbc1"
      },
      {
        "path": "ui/icon-512.png",
        "route": "/icon-512.png",
        "pixel_size": 512,
        "mime_type": "image/png",
        "sha256": "c8c42e31bc34d97b12fd242f99b52ad77d98039a1b39e6844ce88f8357cce539"
      }
    ]
  },
  "runtime_modes": {
    "default": "remote-audiozentrale",
    "persistence": "browser-local-storage",
    "storage_key": "audio-ui-runtime-mode",
    "modes": {
      "local-device": {
        "id": "local-device",
        "label": "Lokales Gerät",
        "backend_requests_allowed": false,
        "backend_authority": "none",
        "native_hardware_authority": false,
        "requires": [
          "a browser that serves the static app shell",
          "a secure context for service-worker registration"
        ],
        "boundary": "Browser capabilities only. No Heim-PC backend requirement, no telemetry polling, no native MOTU, ALSA, PipeWire or Roland authority. Detected APIs are never treated as proven permission, device or hardware."
      },
      "remote-audiozentrale": {
        "id": "remote-audiozentrale",
        "label": "Fern-Audiozentrale",
        "backend_requests_allowed": true,
        "backend_authority": "heim-pc-backend",
        "native_hardware_authority": false,
        "requires": [
          "the private Tailscale Serve frontend on HTTPS 9443",
          "the loopback-only Audiozentrale remote bridge",
          "an identity-bound short-lived bridge session before scoped whale and recording effects"
        ],
        "boundary": "The Heim-PC backend stays authoritative for state. The remote bridge is read-only except for the explicitly typed Buckelwal start/mode/stop, recorder plan/start/stop/recover and recording-library categorize/trash/restore channels; profiles, routing, devices and system effects remain remote-denied."
      }
    }
  },
  "feature_detection": {
    "method": "api-presence-only",
    "user_agent_sniffing": false,
    "automatic_permission_requests": false,
    "fail_closed": true,
    "distinguishes_api_presence_from_proof": true,
    "permissions_policy_read": "where-exposed-only",
    "probes": [
      {
        "id": "secure-context",
        "detects": "window.isSecureContext",
        "invoked_automatically": false,
        "proves": "api-presence-only"
      },
      {
        "id": "service-worker",
        "detects": "navigator.serviceWorker presence",
        "invoked_automatically": false,
        "proves": "api-presence-only"
      },
      {
        "id": "web-audio",
        "detects": "window.AudioContext constructor presence without construction",
        "invoked_automatically": false,
        "proves": "api-presence-only"
      },
      {
        "id": "media-capture",
        "detects": "navigator.mediaDevices.getUserMedia presence without invocation",
        "invoked_automatically": false,
        "proves": "api-presence-only"
      },
      {
        "id": "web-midi",
        "detects": "navigator.requestMIDIAccess presence without invocation",
        "invoked_automatically": false,
        "proves": "api-presence-only"
      }
    ]
  },
  "service_worker": {
    "path": "ui/sw.js",
    "route": "/sw.js",
    "scope": "/",
    "cache_prefix": "audiozentrale-app-shell-",
    "cache_name": "audiozentrale-app-shell-v5",
    "registration": "secure-contexts-only",
    "app_shell_strategy": "network-first-cache-fallback-static-only",
    "app_shell_routes": [
      "/",
      "/index.html",
      "/app.js",
      "/whale-lesson.js",
      "/styles.css",
      "/manifest.webmanifest",
      "/icon-180.png",
      "/icon-192.png",
      "/icon-512.png"
    ],
    "api_rule": {
      "path_prefix": "/api/",
      "behaviour": "network-only",
      "cache_read": false,
      "cache_write": false,
      "cache_fallback": false,
      "replay": false,
      "queue": false,
      "background_sync": false,
      "stale_state": false
    },
    "never_cached": [
      "non-GET and mutation requests",
      "credentials and authorization material",
      "Qobuz and other provider state",
      "playback, routing and device-control responses",
      "live telemetry and snapshot responses",
      "WAV, MIDI and other audio payloads",
      "bridge session and scoped whale/recording action responses"
    ],
    "absent_capabilities": [
      "background sync",
      "periodic background sync",
      "push messaging",
      "background fetch",
      "message-triggered request replay"
    ]
  },
  "transport": {
    "loopback_control_service_is_remote_transport": false,
    "loopback_boundary_preserved": true,
    "microphone_permissions_policy": "denied",
    "api_cache_control": "no-store",
    "remote_mode_requires": [
      "private Tailscale Serve HTTPS transport terminated outside the loopback control service",
      "a loopback-only bridge that requires Tailscale identity plus a bound short-lived session for whale and recording effects",
      "an exact host and Same-Origin gate for the scoped whale and recording POST endpoints"
    ],
    "remote_bridge_proven": false
  },
  "physical_acceptance": {
    "ipad_installation_verified": false,
    "ipad_standalone_launch_verified": false,
    "offline_app_shell_verified": false,
    "remote_bridge_verified": false,
    "local_audio_hardware_verified": false,
    "local_midi_hardware_verified": false
  },
  "does_not_establish": [
    "that the surface has been installed on a physical iPad",
    "that a standalone launch has been observed on iPadOS",
    "that the current scoped remote bridge revision has passed physical Safari/PWA acceptance",
    "that the browser may open, route or capture any audio device",
    "that Web MIDI has been granted or that a Roland device is reachable from the iPad",
    "that the loopback control service may be exposed beyond 127.0.0.1",
    "permission to apply or activate an audio profile"
  ]
}
