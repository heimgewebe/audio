[Unit]
Description=Lokale Audiozentrale
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=5
ConditionPathExists=%h/.local/share/audio-control-ui/current/scripts/audio_control.py
ConditionPathExists=%h/.config/audio-control-ui/runtime.env

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=%h/.config/audio-control-ui/runtime.env
WorkingDirectory=%h/.local/share/audio-control-ui/current
ExecStart=/usr/bin/python3 %h/.local/share/audio-control-ui/current/scripts/audio_control.py serve --host ${AUDIO_CONTROL_HOST} --port ${AUDIO_CONTROL_PORT}
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077
MemoryMax=134217728
CPUQuota=50%
TasksMax=32
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=default.target
