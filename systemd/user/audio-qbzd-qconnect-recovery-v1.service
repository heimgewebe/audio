[Unit]
Description=Fail-closed QBZD QConnect reconnect recovery
Documentation=file:%h/.local/share/audio-control-ui/current/docs/qbzd-qconnect-recovery.md
After=network.target qbzd.service
PartOf=audio-control-ui-v1.service
StartLimitIntervalSec=60
StartLimitBurst=3
ConditionPathExists=%h/.local/share/audio-control-ui/current/scripts/qbzd_qconnect_recovery.py

[Service]
Type=simple
StateDirectory=audio-qbzd-qconnect-recovery
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 %h/.local/share/audio-control-ui/current/scripts/qbzd_qconnect_recovery.py run --state-file ${STATE_DIRECTORY}/state.json
Restart=on-failure
RestartSec=10s
TimeoutStopSec=5s
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077
Nice=10
CPUQuota=5%
MemoryMax=67108864
TasksMax=8
LogRateLimitIntervalSec=60s
LogRateLimitBurst=10
